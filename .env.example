# Copy to .env and fill in. .env is git-ignored — never commit real values.

# --- GCP
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GCS_BUCKET=your-bucket-name

# --- Models (Vertex AI)
# gemini-embedding-001 at 768-d (truncated, so the pipeline L2-normalises it)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-pro

# --- Retrieval backend: pgvector | vertex_vector_search
RETRIEVAL_BACKEND=pgvector
RETRIEVAL_TOP_K=5

# --- Vertex AI Vector Search (populated from terraform outputs)
VECTOR_SEARCH_INDEX_ID=
VECTOR_SEARCH_INDEX_ENDPOINT_ID=
VECTOR_SEARCH_DEPLOYED_INDEX_ID=
# Private Service Connect endpoint IP (only reachable from inside the VPC)
VECTOR_SEARCH_PSC_IP=

# --- Postgres + pgvector (local Docker defaults; Cloud SQL values come from Secret Manager)
PG_HOST=localhost
# 5433 (not 5432) avoids clashing with any other local Postgres
PG_PORT=5433
PG_DATABASE=rag
PG_USER=rag
PG_PASSWORD=change-me-local-only
# disable for local Docker; Cloud Run uses require
PG_SSLMODE=disable

# --- SEC EDGAR (required by SEC fair-access policy: "Name contact@email")
SEC_USER_AGENT="Your Name your-email@example.com"

# --- Ingestion tuning
SEC_REQUESTS_PER_SECOND=5
INGEST_MAX_CONCURRENCY=8
INGEST_MAX_RETRIES=5
EMBED_MAX_CONCURRENCY=4

# --- Logging
LOG_LEVEL=INFO
